# Copy this file to .env and fill in your own key. .env stays on this machine.

# Which conversation brain to use: groq, gemini, ollama or demo.
# It must match where the key below came from: a Groq key (starts with gsk_)
# needs groq, a Google AI Studio key needs gemini.
# Leave empty to use groq when a key is set, otherwise demo (canned replies).
# Restart the server after changing this file.
LLM_PROVIDER=

# Free-tier key from https://console.groq.com/keys (groq)
# or https://aistudio.google.com/apikey (gemini). Not needed for ollama or demo.
LLM_API_KEY=

# Optional overrides. Defaults: groq openai/gpt-oss-120b, gemini gemini-3.5-flash, ollama llama3.2.
LLM_MODEL=
LLM_BASE_URL=

# A shared password for the app. Leave empty on your own PC.
# Required when the app is hosted: without it the server refuses to listen
# on anything but this machine. Pick a long one and share it with the link.
APP_PASSWORD=

# Optional server address. A host sets PORT itself; HOST must be 0.0.0.0 there.
HOST=127.0.0.1
PORT=8000
